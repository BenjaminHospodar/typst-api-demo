# Copy to .env and adjust. Docker Compose reads .env automatically.
# Host-side scripts (seed, tests) also load this file.
#
# Production (docker-compose.prod.yml) requires non-empty
# POSTGRES_PASSWORD, REDIS_PASSWORD, RABBITMQ_PASSWORD, and PDFGEN_API_KEY.

# --- PostgreSQL ---
POSTGRES_DB=pdfgen
POSTGRES_USER=pdfgen
POSTGRES_PASSWORD=pdfgen
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=pdfgen
RABBITMQ_PASSWORD=pdfgen

# --- Java API ---
JAVA_API_PORT=8080
PDFGEN_API_KEY=
JAVA_OPTS=

# --- Rust gRPC compiler ---
GRPC_PORT=50051
GRPC_ADDR=0.0.0.0:50051
RUST_LOG=info
TYPST_ASSETS_DIR=/assets
WORKER_THREADS=4

# --- Host-side URLs (scripts on the host, not the Docker network) ---
DATABASE_URL=postgresql://pdfgen:pdfgen@localhost:5432/pdfgen
REDIS_URL=redis://localhost:6379/0
BASE_URL=http://localhost:8080
